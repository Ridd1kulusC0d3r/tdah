# ---------- Agora: configuração de produção ----------
# Copie para .env e preencha. Nunca envie o .env para o GitHub.

DOMINIO=agora.seudominio.com.br
AGORA_URL_PUBLICA=https://agora.seudominio.com.br
AGORA_AMBIENTE=producao
# Origens que podem chamar a API (o app Android usa https://localhost)
AGORA_CORS=https://localhost,capacitor://localhost

# ---------- Pagamentos ----------
# simulado (só testes, desligado em produção) | mercadopago | stripe
AGORA_PAGAMENTO=mercadopago
# Mercado Pago: Suas integrações > aplicação > Credenciais de produção
MP_ACCESS_TOKEN=APP_USR-...
# Mercado Pago: Webhooks > Configurar notificações > assinatura secreta
#   URL: https://agora.seudominio.com.br/api/webhooks/mercadopago
#   Eventos: Pagamentos, Planos e assinaturas
MP_WEBHOOK_SECRET=
# Stripe (alternativa)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
# Preços em centavos
AGORA_PRECO_PLUS_MENSAL=990
AGORA_PRECO_PLUS_ANUAL=8900
AGORA_PRECO_PRO_MENSAL=6900
AGORA_PRO_GRATIS_PACIENTES=3

# ---------- Google Play (fase 2: venda do Plus dentro do app Android) ----------
PLAY_PACOTE=br.com.agoratdah.app
PLAY_CONTA_SERVICO_JSON=/dados/conta-servico-play.json
PLAY_RTDN_TOKEN=troque-por-um-valor-aleatorio-longo
PLAY_PRODUTOS=agora_plus_mensal:plus_mensal,agora_plus_anual:plus_anual

# ---------- E-mail (recuperação de senha) ----------
AGORA_SMTP_HOST=smtp.seuprovedor.com
AGORA_SMTP_PORTA=587
AGORA_SMTP_USUARIO=
AGORA_SMTP_SENHA=
AGORA_SMTP_REMETENTE=Agora TDAH <nao-responda@seudominio.com.br>

# ---------- Criptografia (OBRIGATÓRIA em produção) ----------
# Gere com:  python3 server/admin.py chave   e guarde uma cópia fora do servidor (gerenciador de senhas).
# Sem ela, o banco e os backups não abrem. Para trocar: mova a atual para AGORA_CHAVES_ANTIGAS,
# coloque a nova aqui, reinicie e rode  python3 server/admin.py recifrar
AGORA_CHAVE=
AGORA_CHAVES_ANTIGAS=

# ---------- Responsável técnico (aparece em todo serviço psicológico) ----------
AGORA_RESPONSAVEL_NOME=Deivison Mendes
AGORA_RESPONSAVEL_CRP=CRP-04/65709
AGORA_CONTATO_PUBLICO=contato@psicologotech.com.br

# ---------- Segurança e operação ----------
AGORA_EXIGIR_2FA_ADMIN=1
# recebe aviso de erro interno (no máximo 1 por hora)
AGORA_ALERTA_EMAIL=
# pedidos de contato sem resposta são apagados depois deste prazo
AGORA_RETENCAO_MESES=24
# lembretes push, e-mails de conteúdo e limpeza rodam dentro do servidor (1 = sim)
AGORA_AGENDADOR=1

# ---------- Lembretes com o app fechado (Web Push) ----------
# Gere com:  python3 server/admin.py vapid
AGORA_VAPID_PRIVADA=
AGORA_VAPID_PUBLICA=
AGORA_VAPID_CONTATO=mailto:contato@psicologotech.com.br

# ---------- Cópia do backup fora do servidor (S3, Backblaze B2, Cloudflare R2, Wasabi) ----------
AGORA_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
AGORA_S3_REGIAO=us-east-005
AGORA_S3_BUCKET=
AGORA_S3_CHAVE=
AGORA_S3_SEGREDO=

# ---------- Homologação (arquivo separado: .env.homologacao) ----------
# Copie este arquivo para .env.homologacao com: AGORA_AMBIENTE=desenvolvimento, AGORA_PAGAMENTO=simulado,
# AGORA_URL_PUBLICA=https://homologacao.seudominio.com.br e OUTRA AGORA_CHAVE. Nunca use dados reais lá.
DOMINIO_HOMOLOGACAO=homologacao.seudominio.com.br
